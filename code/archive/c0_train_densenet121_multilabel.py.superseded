# c0_train_densenet121_multilabel.py
"""
Multi-label C0: DenseNet121 over all 14 CheXpert observations.

This is the standard CheXpert setup (Irvin et al., AAAI 2019): ImageNet-pretrained
DenseNet121, a 14-logit head, per-label BCE, Adam @ 1e-4, model selection on the
mean AUC of the 5 competition pathologies.

Differences from that paper, and why:
  * 224x224 input, not 320x320 -- 224 is baked into the downstream CF generation,
    Grad-CAM and radiomics code, so changing it would invalidate that pipeline.
  * Train/val come from the patient-level 50/50 split of train.csv built by
    c0_multilabel_split.py, not the 234-image official valid set, because the
    val half has to be big enough to feed C1/C2. Run that script once first.
  * No checkpoint ensembling; single best checkpoint by val mean-AUC.
  * No augmentation, matching the existing single-label C0 so the two are
    directly comparable.

Uncertainty policy:
  -1  ->  1  for Atelectasis and Edema
  -1  ->  0  for every other label
  NaN ->  0  everywhere (blank = observation not mentioned = negative)

Provenance, stated precisely: the CheXpert paper's final model used U-Ones for
Atelectasis and Edema, U-MultiClass for Cardiomegaly and Pleural Effusion, and
U-SelfTrained for Consolidation (Irvin et al. 2019, Table 3 + Test Results).
The last two are not expressible in a single-pass 14-logit model -- U-MultiClass
needs a 3-way head per observation, U-SelfTrained needs a train/relabel/retrain
loop -- so this script keeps U-Ones exactly where the paper found it wins and
falls back to U-Zeros elsewhere. That fallback is a simplification, NOT the
paper's recommendation: U-Zeros does not win any column of their Table 3.

It is defensible because the paper found only 2 of the 5 differences significant
(Atelectasis U-Ones > U-Zeros p=0.03; Cardiomegaly U-MultiClass > U-Ignore
p<0.01) and explicitly reports no significant best-vs-worst gap on Consolidation,
Edema and Pleural Effusion. For Cardiomegaly, U-Zeros (0.840) is the strongest of
the three binary policies anyway. Nearest fidelity upgrade if a reviewer pushes:
mask Consolidation (U-Ignore, 0.938 vs U-Zeros 0.932) -- the mask is already
computed in the dataset below.

Validation AUC is computed on confidently-labelled rows only (original -1 rows are
excluded per label), so the reported discrimination does not depend on the choice
of uncertainty policy.
"""
import argparse
import json
import os

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import torch
import torch.nn as nn
from PIL import Image
from sklearn.metrics import roc_auc_score
from torch.utils.data import Dataset, DataLoader
from torchvision import models, transforms

# ── Config ────────────────────────────────────────────────────────────────────
DATA_ROOT = os.environ.get("THESIS_DATA", "/work3/s251710/thesis_data")
SPLIT_DIR = os.path.join(DATA_ROOT, "chexpert_multilabel")
OUTPUT_DIR = "/work3/s251710/thesis_results/C0_custom/chexpert_multilabel"

# The 14 observations, in train.csv column order. This order is the contract
# between the checkpoint's 14 logits and everything that reads them -- it is
# written to labels.json next to the weights.
LABELS = [
    "No Finding", "Enlarged Cardiomediastinum", "Cardiomegaly", "Lung Opacity",
    "Lung Lesion", "Edema", "Consolidation", "Pneumonia", "Atelectasis",
    "Pneumothorax", "Pleural Effusion", "Pleural Other", "Fracture",
    "Support Devices",
]
COMPETITION = ["Atelectasis", "Cardiomegaly", "Consolidation", "Edema",
               "Pleural Effusion"]
U_ONES = ["Atelectasis", "Edema"]          # -1 -> 1; every other label -1 -> 0
                                           # (see the uncertainty-policy note above)

N_EPOCHS = 10
BATCH_SIZE = 32
LR = 1e-4
DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")

COMP_IDX = [LABELS.index(c) for c in COMPETITION]


# ── Dataset ───────────────────────────────────────────────────────────────────
class CheXpertMultiLabelDataset(Dataset):
    """Returns (image, target[14], mask[14]).

    target applies the U-Ones/U-Zeros policy and is what the loss sees.
    mask is 0 where the raw label was uncertain (-1); it is used only to exclude
    those entries from the val AUCs.
    """

    def __init__(self, df, data_dir, transform=None):
        self.paths = df["Path"].to_numpy()
        self.data_dir = data_dir
        self.transform = transform

        raw = df[LABELS].to_numpy(dtype=np.float32)     # 1 / 0 / -1 / NaN
        uncertain = raw == -1.0
        blank = np.isnan(raw)

        target = np.where(blank, 0.0, raw)
        u_ones_cols = np.array([lbl in U_ONES for lbl in LABELS])
        target = np.where(uncertain, u_ones_cols[None, :].astype(np.float32), target)

        self.targets = target.astype(np.float32)
        self.masks = (~uncertain).astype(np.float32)

    def __len__(self):
        return len(self.paths)

    def __getitem__(self, idx):
        img = Image.open(os.path.join(self.data_dir, self.paths[idx])).convert("RGB")
        if self.transform:
            img = self.transform(img)
        return img, torch.from_numpy(self.targets[idx]), torch.from_numpy(self.masks[idx])


# ── Transforms ────────────────────────────────────────────────────────────────
transform = transforms.Compose([
    transforms.Resize((224, 224)),
    transforms.ToTensor(),
    transforms.Normalize([0.485, 0.456, 0.406],
                         [0.229, 0.224, 0.225])
])


# ── Model ─────────────────────────────────────────────────────────────────────
def build_model(n_labels=len(LABELS)):
    model = models.densenet121(weights="IMAGENET1K_V1")
    model.classifier = nn.Linear(model.classifier.in_features, n_labels)
    return model


# ── One epoch ─────────────────────────────────────────────────────────────────
def train_one_epoch(model, loader, optimizer, criterion, device, scaler=None):
    model.train()
    total_loss = 0
    for imgs, targets, _ in loader:
        imgs, targets = imgs.to(device, non_blocking=True), targets.to(device, non_blocking=True)
        optimizer.zero_grad(set_to_none=True)
        with torch.autocast("cuda", enabled=scaler is not None):
            loss = criterion(model(imgs), targets)
        if scaler is not None:
            scaler.scale(loss).backward()
            scaler.step(optimizer)
            scaler.update()
        else:
            loss.backward()
            optimizer.step()
        total_loss += loss.item()
    return total_loss / len(loader)


# ── Evaluation ────────────────────────────────────────────────────────────────
def evaluate(model, loader, criterion, device, use_amp=False):
    model.eval()
    total_loss, probs, targets, masks = 0, [], [], []
    with torch.no_grad():
        for imgs, tgt, msk in loader:
            imgs, tgt = imgs.to(device, non_blocking=True), tgt.to(device, non_blocking=True)
            with torch.autocast("cuda", enabled=use_amp):
                logits = model(imgs)
                total_loss += criterion(logits, tgt).item()
            probs.append(torch.sigmoid(logits.float()).cpu().numpy())
            targets.append(tgt.cpu().numpy())
            masks.append(msk.numpy())

    probs = np.concatenate(probs)
    targets = np.concatenate(targets)
    masks = np.concatenate(masks).astype(bool)

    # AUC per label on confidently-labelled rows only (uncertain excluded).
    aucs = {}
    for j, lbl in enumerate(LABELS):
        y = targets[masks[:, j], j]
        p = probs[masks[:, j], j]
        aucs[lbl] = roc_auc_score(y, p) if len(np.unique(y)) == 2 else float("nan")

    mean_comp_auc = float(np.mean([aucs[c] for c in COMPETITION]))
    return total_loss / len(loader), aucs, mean_comp_auc


# ── Main ──────────────────────────────────────────────────────────────────────
if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Train a 14-label DenseNet121 C0 on CheXpert (frontal only)."
    )
    parser.add_argument("--epochs", type=int, default=N_EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument("--num-workers", type=int, default=8)
    parser.add_argument("--no-amp", action="store_true",
                        help="Disable mixed precision (on by default on CUDA).")
    parser.add_argument("--limit", type=int, default=None,
                        help="Debug: use only the first N rows of each split.")
    args = parser.parse_args()

    use_amp = (not args.no_amp) and DEVICE.type == "cuda"
    os.makedirs(OUTPUT_DIR, exist_ok=True)

    print("Multi-label C0 (14 CheXpert observations, frontal only)")
    print(f"  splits:  {SPLIT_DIR}")
    print(f"  output:  {OUTPUT_DIR}")
    print(f"  device:  {DEVICE} | amp: {use_amp}")
    print(f"  policy:  U-Ones for {U_ONES}, U-Zeros elsewhere, blanks -> 0")

    train_df = pd.read_csv(os.path.join(SPLIT_DIR, "c0_train_split.csv"))
    val_df = pd.read_csv(os.path.join(SPLIT_DIR, "c0_val_split.csv"))
    if args.limit:
        train_df, val_df = train_df.head(args.limit), val_df.head(args.limit)
    print(f"  train:   {len(train_df):,} images | val: {len(val_df):,} images")

    train_ds = CheXpertMultiLabelDataset(train_df, DATA_ROOT, transform)
    val_ds = CheXpertMultiLabelDataset(val_df, DATA_ROOT, transform)
    print("  train prevalence after policy: "
          + ", ".join(f"{l}={train_ds.targets[:, j].mean():.1%}"
                      for j, l in enumerate(LABELS) if l in COMPETITION))

    train_loader = DataLoader(train_ds, batch_size=args.batch_size, shuffle=True,
                              num_workers=args.num_workers, persistent_workers=True,
                              pin_memory=True)
    val_loader = DataLoader(val_ds, batch_size=args.batch_size, shuffle=False,
                            num_workers=args.num_workers, persistent_workers=True,
                            pin_memory=True)

    model = build_model().to(DEVICE)
    criterion = nn.BCEWithLogitsLoss()
    optimizer = torch.optim.Adam(model.parameters(), lr=args.lr)
    scaler = torch.amp.GradScaler("cuda") if use_amp else None

    # Label order is the checkpoint's contract -- write it next to the weights.
    with open(os.path.join(OUTPUT_DIR, "labels.json"), "w") as f:
        json.dump({"labels": LABELS, "competition": COMPETITION,
                   "u_ones": U_ONES, "input_size": 224}, f, indent=2)

    train_losses, val_losses, history = [], [], []
    best_auc = 0

    for epoch in range(args.epochs):
        train_loss = train_one_epoch(model, train_loader, optimizer, criterion,
                                     DEVICE, scaler)
        val_loss, aucs, mean_comp_auc = evaluate(model, val_loader, criterion,
                                                 DEVICE, use_amp)

        train_losses.append(train_loss)
        val_losses.append(val_loss)
        history.append({"epoch": epoch + 1, "train_loss": train_loss,
                        "val_loss": val_loss, "mean_comp_auc": mean_comp_auc, **aucs})

        print(f"\nEpoch {epoch+1:02d} | Train Loss: {train_loss:.4f} | "
              f"Val Loss: {val_loss:.4f} | Mean AUC (5 competition): {mean_comp_auc:.4f}")
        for lbl in LABELS:
            star = " *" if lbl in COMPETITION else ""
            print(f"    {lbl:<28} {aucs[lbl]:.4f}{star}")

        if mean_comp_auc > best_auc:
            best_auc = mean_comp_auc
            torch.save(model.state_dict(), os.path.join(OUTPUT_DIR, "c0_best.pt"))
            print(f"  -> Saved new best model (mean competition AUC={best_auc:.4f})")

    pd.DataFrame(history).to_csv(os.path.join(OUTPUT_DIR, "train_history.csv"), index=False)

    # ── Plots ─────────────────────────────────────────────────────────────────
    plt.figure()
    plt.plot(train_losses, label="Train Loss")
    plt.plot(val_losses, label="Val Loss")
    plt.legend(); plt.xlabel("Epoch"); plt.title("Loss (multi-label C0)")
    plt.savefig(os.path.join(OUTPUT_DIR, "loss.png")); plt.close()

    hist = pd.DataFrame(history)
    plt.figure()
    for lbl in COMPETITION:
        plt.plot(hist["epoch"], hist[lbl], alpha=0.6, label=lbl)
    plt.plot(hist["epoch"], hist["mean_comp_auc"], color="k", lw=2, label="mean (5)")
    plt.legend(fontsize=8); plt.xlabel("Epoch"); plt.ylabel("Val AUC")
    plt.title("Val AUC (multi-label C0)")
    plt.savefig(os.path.join(OUTPUT_DIR, "auc.png")); plt.close()

    print(f"\nBest mean competition AUC: {best_auc:.4f}")
